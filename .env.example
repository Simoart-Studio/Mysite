# Skopiuj do .env.local (plik ignorowany przez git) i uzupełnij lokalnie.
# Na produkcji ustaw w Vercel → Settings → Environment Variables. Nigdy nie commituj wartości.

# WYMAGANE na produkcji (build produkcyjny bez nich kończy się błędem — scripts/check-env.mjs).
# Skrzynka, na którą trafiają zapytania z formularza i z której są wysyłane (Gmail SMTP).
GMAIL_USER=
# Hasło aplikacji Google (16 znaków, Konto Google → Bezpieczeństwo → Hasła aplikacji). Sekret, tylko serwer.
GMAIL_APP_PASSWORD=

# OPCJONALNE. Token GitHub tylko do odczytu — pobieranie danych repozytoriów do talii projektów przy buildzie.
# Bez niego skrypt czyta tylko repozytoria publiczne. Sekret, tylko build.
GITHUB_TOKEN=
